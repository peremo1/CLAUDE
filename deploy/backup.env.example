# Copia esto como deploy/backup.env para subir las copias cifradas fuera del VPS con restic.
# Ejemplo con otro VPS pequeño por SFTP (configura antes una llave SSH sin contraseña hacia él):
RESTIC_REPOSITORY=sftp:backup@IP_DEL_OTRO_SERVIDOR:/srv/restic/zaber
# Contraseña de cifrado. GUÁRDALA EN UN SITIO SEGURO: sin ella las copias no se pueden recuperar.
RESTIC_PASSWORD=
