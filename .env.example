# Copia este archivo como .env en el VPS y rellena los valores. Nunca subas .env a GitHub.

# Tu dominio, sin https:// ni barras. Crea en Njalla dos registros A (@ y www) apuntando a la IP del VPS.
DOMAIN=zaberovich.com

# Correo para avisos de Let's Encrypt (caducidad de certificados). Puede ser cualquiera tuyo.
LETSENCRYPT_EMAIL=

# Contraseña de la base de datos. Genera una larga con: openssl rand -hex 32
POSTGRES_PASSWORD=

# Correo saliente (recuperar contraseña y avisos). Opcional: sin esto, los correos solo
# aparecen en el registro del servidor (docker compose logs app).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=0
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Zaber <no-reply@zaberovich.com>
